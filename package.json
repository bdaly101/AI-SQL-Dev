{
  "name": "ai-sql-dev",
  "version": "1.0.0",
  "description": "CLI tool that analyzes your Supabase schema and TypeScript codebase to generate intelligent database migrations and Row Level Security policies",
  "main": "dist/index.js",
  "bin": {
    "ai-sql-dev": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "supabase",
    "sql",
    "migrations",
    "rls",
    "cli"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "chalk": "^4.1.2",
    "commander": "^12.0.0",
    "glob": "^10.3.10",
    "inquirer": "^8.2.6",
    "ora": "^5.4.1"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/inquirer": "^8.2.10",
    "@types/node": "^20.11.5",
    "@typescript-eslint/eslint-plugin": "^6.19.1",
    "@typescript-eslint/parser": "^6.19.1",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3",
    "vitest": "^4.0.15"
  }
}
